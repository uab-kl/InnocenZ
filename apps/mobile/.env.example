# Copy to apps/mobile/.env for local runs. EAS builds read these from the
# dashboard environment named by each profile's `environment` field in eas.json.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time — they are
# public. Never put a server-side secret here.

# Google Maps key used by the check-in map (app.config.js). Required: the config
# throws without it. Restrict the key to the app's package name / bundle ID and
# the Maps SDKs in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend base URL. Leave blank locally to let api.ts autodetect the dev
# machine's LAN IP from Expo's hostUri.
EXPO_PUBLIC_API_URL=

# Public R2 bucket base for profile and proof photos. Optional — the app also
# learns this from the backend's `r2PublicUrl` field.
EXPO_PUBLIC_R2_PUBLIC_URL=
