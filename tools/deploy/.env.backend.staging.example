# Copy to tools/deploy/.env.backend.staging and fill with STAGING secrets.
# See .env.backend.example for the full key list.
#
# pnpm deploy:staging uploads THIS file to the server as .env.backend
# (and will no longer replace it with an empty example).

NODE_ENV=production
BACKEND_PORT=7777
FRONTEND_URL=https://YOUR_STAGING_DOMAIN

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
DATABASE_URL=

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# One reverse proxy (Caddy / the host proxy) sits in front of the API, so trust
# exactly one hop. Unset, the rate limiter sees the proxy's address on every
# request and throttles the whole platform as one caller. Production defaults to
# 1 since 28 Sep 2026; stated here so the value is visible. Never `true`.
TRUST_PROXY=1

# PR KPI score — PRIVATE: the KPI weights. Set on each server; NEVER commit values
# (the repo is public). Format: reliability=<n>,punctuality=<n>,rating=<n> (any
# order; plain numbers >= 0, reliability > 0). Unset or malformed: no KPI is scored
# (every PR shows a dash) and the backend logs one warning.
KPI_WEIGHTS=

R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# --- Landing-page chat (Gemini) — optional; without a key the chat uses its written answers ---
# Key from Google AI Studio on a project WITHOUT billing ("Free tier"). Never the
# billed Maps project. Server-only: never put it in a VITE_ or EXPO_PUBLIC_ variable.
GEMINI_API_KEY=
# Optional: comma-separated models tried in order (default gemini-flash-lite-latest,gemini-3.5-flash).
GEMINI_MODEL=
# Optional: AI questions per day for the whole site (default 1000; 0 turns the AI off).
LANDING_CHAT_DAILY_LIMIT=
