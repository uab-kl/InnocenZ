# Copy to tools/deploy/.env.backend.staging and fill with STAGING secrets.
# See .env.backend.example for the full key list.
#
# pnpm deploy:staging uploads THIS file to the server as .env.backend
# (and will no longer replace it with an empty example).

NODE_ENV=production
BACKEND_PORT=7777
FRONTEND_URL=https://YOUR_STAGING_DOMAIN

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
DATABASE_URL=

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
