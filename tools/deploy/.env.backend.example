# Runtime env for the backend container (staging / production).
# Copy to:  tools/deploy/.env.backend.staging   or   .env.backend.production
# Never commit the filled file — git-ignored.
#
# Deploy uploads ONLY a real .env.backend.<env> (or .env.backend).
# It will NOT overwrite the server with this .example file anymore.

NODE_ENV=production
BACKEND_PORT=7777

# Public site (CORS / invite links)
FRONTEND_URL=https://YOUR_STAGING_DOMAIN

# Postgres — staging DB (NOT production)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
DATABASE_URL=

# JWT (same keypair style as local .env)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# One reverse proxy (Caddy / the host proxy) sits in front of the API, so trust
# exactly one hop. Unset, the rate limiter sees the proxy's address on every
# request and throttles the whole platform as one caller. Production defaults to
# 1 since 28 Sep 2026; stated here so the value is visible. Never `true`.
TRUST_PROXY=1

# PR KPI score — PRIVATE: the KPI weights. Set on each server; NEVER commit values
# (the repo is public). Format: reliability=<n>,punctuality=<n>,rating=<n> (any
# order; plain numbers >= 0, reliability > 0). Unset or malformed: no KPI is scored
# (every PR shows a dash) and the backend logs one warning.
KPI_WEIGHTS=

# Cloudflare R2 — staging bucket + matching public URL + token scoped to that bucket
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Optional mail
# SENDER_EMAIL=
# ADMIN_EMAIL=
# BREVO_SMTP_HOST=
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=
