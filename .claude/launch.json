{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "innocenz-admin", "dev"],
      "port": 3000
    },
    {
      "name": "web-3001",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "innocenz-admin", "dev", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "innocenz-backend", "dev"],
      "port": 7777
    },
    {
      "name": "mobile",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/scripts/dev-mobile.mjs"],
      "port": 8081
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/scripts/dev-mobile-web.mjs"],
      "port": 8081
    }
  ]
}
