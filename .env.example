# Frontend (Next.js)
WEB_PORT=

# Backend 
BACKEND_PORT=

# Public API URL used by the web app (browser-visible)
NEXT_PUBLIC_API_URL=

# Server key for the Google Geocoding API — powers the outlet form's
# "look up address" button (GET /api/v1/outlet/geocode?address=...).
# Optional: leave unset and operators drop the outlet pin on the map by hand.
# This must be a SERVER key. The key in apps/mobile/app.json is a client key
# restricted to the app's bundle id and Google will reject it here.
GOOGLE_MAPS_API_KEY=
