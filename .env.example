###############################################################################
# WEB FRONTEND (apps/web � Vite)
# Prefix: VITE_*  |  Port: WEB_PORT
###############################################################################
WEB_PORT=3000
VITE_API_URL=http://localhost:7777/api
VITE_GRAPHQL_ENDPOINT=http://localhost:7777/graphql
# Same R2 public base as backend/mobile (Vite can only read VITE_*).
VITE_R2_PUBLIC_URL=https://pub-<id>.r2.dev
# Deploy / legacy (tools/scripts/deploy.mjs). Local Vite uses VITE_API_URL above.
NEXT_PUBLIC_API_URL=http://localhost:7777/api

###############################################################################
# MOBILE (apps/mobile � Expo)
# Prefix: EXPO_PUBLIC_*
###############################################################################
# Physical phone on Wi-Fi needs this PC's LAN IP (not localhost). Restart Expo after change.
EXPO_PUBLIC_API_URL=http://192.168.x.x:7777/api
# Same R2 public base as backend/web (Expo can only read EXPO_PUBLIC_*).
EXPO_PUBLIC_R2_PUBLIC_URL=https://pub-<id>.r2.dev

###############################################################################
# BACKEND (apps/backend)
###############################################################################
NODE_ENV=development
BACKEND_PORT=7777
# CORS + password-reset links (web origin, not a Vite var)
FRONTEND_URL=http://localhost:3000/en
API_URL=http://localhost:7777/api

# --- Auth (JWT) ---
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=15d
JWT_REFRESH_TOKEN_EXPIRATION=7d

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
DATABASE_URL=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1

# --- Email / SMTP ---
SENDER_EMAIL=
SMTP_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAILJET_APIKEY_PUBLIC=
MAILJET_APIKEY_PRIVATE=
ADMIN_EMAIL=

# --- Seed admin ---
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=

# --- Logging ---
LOG_LEVEL=info
LOKI_HOST=
LOG_ENV=development

# --- Google Maps (SERVER key for outlet geocode; not the mobile client key in app.json) ---
GOOGLE_MAPS_API_KEY=

# --- WhatsApp Cloud API (Meta) � PR phone OTP + webhooks ---
# Callback: https://<public-host>/api/v1/webhooks/whatsapp
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_OTP_TEMPLATE=login_code
META_WHATSAPP_OTP_TEMPLATE_LANG=en_US

# --- Cloudflare R2 (S3-compatible) � profile / comcard / portfolio ---
# Dashboard ? R2 ? API tokens. Public URL = bucket ? Settings ? Public access (r2.dev).
# Credentials are backend-only. DB stores KEYS; keep the three *R2_PUBLIC_URL values identical.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_URL=https://pub-<id>.r2.dev
