# Frontend (Next.js)
WEB_PORT=3000

# Backend (NestJS)
BACKEND_PORT=7777

# Public API URL used by the web app (browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:7777/api

# Deploy web + backend to a server via SSH + Docker Hub (tools/scripts/deploy.mjs)
# Auth uses your local SSH key already trusted by the server, and `docker login`
# for the Docker Hub push — no secret needed in this file.
DEPLOY_HOST=
DEPLOY_USER=
# DEPLOY_SSH_PORT=22
# DEPLOY_REMOTE_DIR=~/innocenz
# DEPLOY_DOMAIN=innocenz.duckdns.org
# FRONTEND_IMAGE=juneyou/innocenz-frontend:latest
# BACKEND_IMAGE=juneyou/innocenz-backend:latest
# NEXT_PUBLIC_API_URL is derived from DEPLOY_DOMAIN by default (https://api.<domain>/api);
# set it explicitly if the backend is reachable at a different public URL.
# NEXT_PUBLIC_API_URL=https://api.innocenz.duckdns.org/api
