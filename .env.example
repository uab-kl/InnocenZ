# Frontend (Next.js)
WEB_PORT=

# Backend 
BACKEND_PORT=

# Public API URL used by the web app (browser-visible)
NEXT_PUBLIC_API_URL=

# Server key for the Google Geocoding API â€” powers the outlet form's
# "look up address" button (GET /api/v1/outlet/geocode?address=...).
# Optional: leave unset and operators drop the outlet pin on the map by hand.
# This must be a SERVER key. The key in apps/mobile/app.json is a client key
# restricted to the app's bundle id and Google will reject it here.
GOOGLE_MAPS_API_KEY=

# WhatsApp Cloud API (Meta) — PR mobile phone OTP + webhooks
# Callback URL: https://<public-host>/api/v1/webhooks/whatsapp
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v21.0
# Auth template from the same WABA as PHONE_NUMBER_ID (Meta ? Message templates)
META_WHATSAPP_OTP_TEMPLATE=login_code
META_WHATSAPP_OTP_TEMPLATE_LANG=en_US

